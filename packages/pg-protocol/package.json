{
  "name": "@supabase/pg-protocol",
  "version": "1.13.2",
  "description": "The postgres client/server binary protocol, implemented in TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/*": "./dist/*.js",
    "./dist/*.js": "./dist/*.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/chai": "^4.2.7",
    "@types/mocha": "^10.0.10",
    "@types/node": "^16",
    "chai": "^4.2.0",
    "chunky": "^0.0.0",
    "mocha": "^11.7.5",
    "ts-node": "^8.5.4",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "test": "mocha dist/**/*.test.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "prebuild": "npm run clean",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "prepublish": "yarn build",
    "pretest": "yarn build"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/supabase/node-postgres.git",
    "directory": "packages/pg-protocol"
  },
  "files": [
    "/dist/*{js,ts,map}",
    "/src",
    "/esm"
  ]
}
